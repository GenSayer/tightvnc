				RuntimeLibrary="0"
				EnableFunctionLevelLinking="TRUE"
				UsePrecompiledHeader="2"
				PrecompiledHeaderThrough="stdhdrs.h"
				PrecompiledHeaderFile=".\./Release/vncviewer/vncviewer.pch"
				AssemblerListingLocation=".\./Release/vncviewer/"
